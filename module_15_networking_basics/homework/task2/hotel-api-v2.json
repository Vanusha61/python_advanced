{
	"info": {
		"name": "Hotel API v2 (RESTful)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Получить список свободных комнат",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/rooms",
					"host": ["{{baseUrl}}"],
					"path": ["rooms"]
				}
			},
			"response": []
		},
		{
			"name": "Получить одну комнату по ID",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/rooms/1",
					"host": ["{{baseUrl}}"],
					"path": ["rooms", "1"]
				}
			},
			"response": []
		},
		{
			"name": "Создать новую комнату",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"floor\": 2,\n    \"beds\": 2,\n    \"guestNum\": 3,\n    \"price\": 1500\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/rooms",
					"host": ["{{baseUrl}}"],
					"path": ["rooms"]
				}
			},
			"response": []
		},
		{
			"name": "Забронировать комнату",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"roomId\": 1,\n    \"firstName\": \"John\",\n    \"lastName\": \"Smith\",\n    \"bookingDates\": {\n        \"checkIn\": \"2025-01-10\",\n        \"checkOut\": \"2025-01-15\"\n    }\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/bookings",
					"host": ["{{baseUrl}}"],
					"path": ["bookings"]
				}
			},
			"response": []
		},
		{
			"name": "Отменить бронирование",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/bookings/1",
					"host": ["{{baseUrl}}"],
					"path": ["bookings", "1"]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://127.0.0.1:5000",
			"type": "string"
		}
	]
}